{
  "$schema": "https://schema.tauri.app/config/1",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000"
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/ml_imp.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/python-runtime",
      "resources/wheelhouse",
      "../src/python",
      "../requirements.txt"
    ],
    "externalBin": [],
    "macOS": {
      "entitlements": null,
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": "-"
    }
  },
  "productName": "MLImpute",
  "mainBinaryName": "ml-impute",
  "version": "0.1.0",
  "identifier": "net.maizegenetics.mlimpute",
  "plugins": {},
  "app": {
    "security": {
      "csp": null
    },
    "windows": [
      {
        "title": "MLImpute",
        "width": 1200,
        "height": 900,
        "useHttpsScheme": true
      }
    ]
  }
}
