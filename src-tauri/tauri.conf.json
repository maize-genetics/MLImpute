{
  "$schema": "https://schema.tauri.app/config/1",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000"
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "msi", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/python-runtime",
      "resources/wheelhouse",
      "../src/python",
      "../requirements.txt"
    ],
    "externalBin": [],
    "deb": {
      "depends": [],
      "files": {
        "/usr/lib/ml-impute/": "resources/"
      }
    }
  },
  "productName": "ml-impute",
  "mainBinaryName": "ml-impute",
  "version": "0.1.0",
  "identifier": "net.maizegenetics.mlimpute",
  "plugins": {},
  "app": {
    "security": {
      "csp": null
    },
    "windows": [
      {
        "title": "ML Impute",
        "width": 1000,
        "height": 800,
        "useHttpsScheme": true
      }
    ]
  }
}
